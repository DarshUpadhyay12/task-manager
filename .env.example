# Copy this file to .env and replace the values for your local environment.
# PostgreSQL connection (use individual vars OR provide DATABASE_URL for cloud hosting like Neon/Render)
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DB_NAME=api_practice
DB_USER=replace-with-a-local-database-user
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5433
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Set to 1 behind a reverse proxy (e.g. Render / Heroku / AWS ALB) to trust forwarded headers.
TRUST_PROXY_HOPS=0

# Gateway and service ports
GATEWAY_PORT=5005
AUTH_SERVICE_PORT=5001
TASK_SERVICE_PORT=5002
ADMIN_SERVICE_PORT=5003

# Internal URL routing for the service layer
AUTH_SERVICE_URL=http://localhost:5001
TASK_SERVICE_URL=http://localhost:5002
ADMIN_SERVICE_URL=http://localhost:5003

# Optional: set this to an existing account email to grant admin access.
# ADMIN_EMAIL=existing-user@example.com
